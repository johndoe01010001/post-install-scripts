theme = "Catppuccin Mocha"
font-family = "JetBrainsMono Nerd Font"
font-size = 12
background-opacity = 0.95
background-blur = true
window-padding-x = 10
# starship adds some vertical padding on the top already
window-padding-y = 0,10
# can mess with top vertical padding
window-padding-balance = false
# for 16:9: width 120 and height 33.75 character cells
window-width = 120
window-height = 34
# Avoid having to `export TERM=xterm-256color` on SSH hosts
shell-integration-features = ssh-env,ssh-terminfo

